# 安装脚本会自动生成 .env 并随机生成密码与密钥，通常无需手工创建。
# 如需自定义，复制本文件为 .env 后修改，chmod 600 .env。

POSTGRES_USER=litellm
POSTGRES_PASSWORD=<自动生成>
POSTGRES_DB=litellm
DATABASE_URL=postgresql://litellm:<密码>@db:5432/litellm
POSTGRES_HOST_PORT=5432

LITELLM_MASTER_KEY=sk-<自动生成>
LITELLM_SALT_KEY=sk-<自动生成>
LITELLM_BIND=0.0.0.0
PROMETHEUS_HOST_PORT=9090

REDIS_PASSWORD=<自动生成>
REDIS_HOST_PORT=6379

# 提示词压缩服务（headroom），仅绑定本机地址，供 litellm 容器内调用
HEADROOM_HOST_PORT=8787

UI_USERNAME=admin
UI_PASSWORD=<自动生成>

DEEPSEEK_API_KEY=
DEEPSEEK_API_KEY_2=
